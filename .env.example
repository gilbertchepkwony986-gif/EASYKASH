# EasyKash Live M-Pesa Payment Gateway Configuration

# Option 1: UpesiPay / PesiPay
UPESIPAY_BASE_URL=https://api.pesipay.com
UPESIPAY_API_KEY=your_live_upesipay_api_key_here
UPESIPAY_MERCHANT_ID=400200
UPESIPAY_CALLBACK_URL=https://your-app-name.onrender.com/api/upesipay/callback

# Verification / Fee Amount (KES)
VERIFICATION_FEE=95

# Server Port
PORT=3000
